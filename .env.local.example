# APIMart API Key
# 从 https://apimart.ai/ 获取你的 API Key
APIMART_API_KEY=your_api_key_here

# ComfyUI over SSH (optional; these can also be configured in Settings)
COMFYUI_SSH_HOST=your-comfyui-ssh-host
COMFYUI_SSH_PORT=22
COMFYUI_SSH_USER=root
# Leave empty to use ssh-agent / ~/.ssh
COMFYUI_SSH_KEY_PATH=
# Optional unattended/server fallback: Base64-encoded private key. Never use NEXT_PUBLIC_.
# Interactive browser sessions can select a local key in Settings instead.
COMFYUI_SSH_PRIVATE_KEY_B64=
# Optional but recommended: pin the server host key, e.g. SHA256:abc...
COMFYUI_SSH_HOST_FINGERPRINT=
COMFYUI_PORT=8188
COMFYUI_WORKFLOW_ROOT=/root/ComfyUI
# Leave workflow paths empty to auto-discover J18IP-compatible 4-step LoRA workflows
COMFYUI_IMAGE_WORKFLOW_PATH=
COMFYUI_MULTI_IMAGE_WORKFLOW_PATH=
COMFYUI_FIRST_LAST_WORKFLOW_PATH=
COMFYUI_TIMEOUT_SECONDS=7200
